# Required. Never commit a real Discord webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Service settings
RUN_SINGLE_CHART_TEST=false
TEST_STOCK=GAIL
SCAN_INTERVAL=300
REQUEST_TIMEOUT=15
ERROR_RETRY_INTERVAL=60
CHART_WIDTH=1800
CHART_HEIGHT=1100
CHARTINK_WAIT_SECONDS=10
CHART_MAX_RETRIES=2

# false matches the supplied script: on a brand-new install, current matches
# will be treated as new and alerted. Set true to silently establish a baseline
# on the first successful scan instead.
BASELINE_ON_FIRST_SCAN=false
STATE_FILE=/opt/chartink-discord/data/last_matches.json
LOG_LEVEL=INFO
